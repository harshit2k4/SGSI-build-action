# --- HOW TO USE ---
# 1. Provide a direct download link to a flashable ROM .zip or .img in ROM_URL
# 2. Set OS_TYPE to a supported type (e.g., Generic, Pixel, OneUI, HyperOS, OxygenOS, ColorOS)
# 3. Set BUILD_TYPE to AB (for modern A/B devices) or A (for older A-only devices)
# 4. Set VERSION to the Android version (e.g., 12, 13, 14, 15, 16)
# 5. Commit these changes to trigger the build, or run manually via Actions tab!

# --- EXAMPLE: Generic Android 14 ---
# ROM_URL=https://example.com/lineage-21.0-nightly-vendor.zip
# ZIP_NAME=update.zip
# OS_TYPE=Generic
# BUILD_TYPE=AB
# REPACK_NAME=SGSI_Generic_A14.zip
# VERSION=14

# --- ACTIVE CONFIGURATION ---
ROM_URL=https://downloads.sourceforge.net/project/pixelexperiencerom/miatoll/PixelExperience_miatoll-12.0-20220125-1725-OFFICIAL.zip?ts=gAAAAABqalQzfsiOymd_mcfyPWVML69MccZ_5YbnFHavz5kJPXIE-sZ_RxhLvlU8M9-RK_vVShxDzFFUUlT1SD9QrtRzSqYtHw%3D%3D&r=https%3A%2F%2Fsourceforge.net%2Fprojects%2Fpixelexperiencerom%2Ffiles%2Fmiatoll%2FPixelExperience_miatoll-12.0-20220125-1725-OFFICIAL.zip%2Fdownload
ZIP_NAME=update.zip
OS_TYPE=Generic
BUILD_TYPE=AB
REPACK_NAME=SGSI.zip
VERSION=12.1
